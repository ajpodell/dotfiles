" ----- New section for configuring plugins in Lua. must go after vundle#end() ----- "

" ------- MARKVIEW------- "
" Configure markview after plugins are loaded
" To use Nerd Font icons instead, install a font (brew install --cask font-hack-nerd-font)
" then remove the preset: require("markview").setup({})
lua << EOF
require("markview").setup({
    preview = {
        -- Modes where preview is shown
        modes = { "n", "no", "c" },
        -- Modes where hybrid mode can be enabled (raw text around cursor)
        hybrid_modes = { "n" },
        -- Only show raw text on current line (0 lines above/below)
        edit_range = { 0, 0 },
    }
})
EOF

" Markview keymaps
nnoremap <leader>ms :Markview splitToggle<CR>
nnoremap <leader>mh :Markview HybridToggle<CR>
nnoremap <leader>mm :Markview<CR>

" ------- PYTHON LSP: pyright (type checking) + ruff (linting & formatting) ------- "
lua << EOF
-- Neovim 0.12+ native LSP config (no lspconfig wrapper needed)

-- Auto-detect virtualenv python path so pyright resolves packages correctly.
-- Checks $VIRTUAL_ENV first, then .venv in project root (common with uv).
local function detect_python_path(root_dir)
    local venv = os.getenv('VIRTUAL_ENV')
    if venv then
        return venv .. '/bin/python'
    end
    if root_dir then
        local venv_python = root_dir .. '/.venv/bin/python'
        if vim.fn.executable(venv_python) == 1 then
            return venv_python
        end
    end
    return nil
end

-- Pyright: type checking & go-to-definition/references/hover/rename
-- To disable diagnostics (e.g. if reverting to mypy via ALE), set diagnosticMode = 'off'
vim.lsp.config('pyright', {
    cmd = { 'pyright-langserver', '--stdio' },
    filetypes = { 'python' },
    root_markers = { 'pyproject.toml', 'setup.py', 'setup.cfg', '.git' },
    settings = {
        python = {
            analysis = {
                diagnosticMode = 'openFilesOnly',
            },
        },
    },
    on_init = function(client)
        local python_path = detect_python_path(client.root_dir)
        if python_path then
            client.settings = vim.tbl_deep_extend('force', client.settings, {
                python = { pythonPath = python_path },
            })
            client:notify('workspace/didChangeConfiguration', {
                settings = client.settings,
            })
        end
    end,
})
vim.lsp.enable('pyright')

-- Ruff LSP: linting diagnostics + formatting (replaces ALE ruff linter/fixer for python)
-- Uses ruff's built-in language server (ruff server)
vim.lsp.config('ruff', {
    cmd = { 'ruff', 'server' },
    filetypes = { 'python' },
    root_markers = { 'pyproject.toml', 'ruff.toml', '.ruff.toml', 'setup.py', '.git' },
    settings = {
        ruff = {
            configuration = '~/bookkeeping/ruff.toml',
            -- Don't auto-remove unused imports (F401) — too aggressive while editing.
            -- Still caught at pre-commit.
            lint = {
                extendFixableRules = {},
                extendUnfixableRules = { 'F401' },
            },
        },
    },
})
vim.lsp.enable('ruff')

-- Workaround: pyright publishes stale diagnostics during initial workspace
-- indexing that it won't reproduce after a buffer reload. This automates the
-- manual :e fix — once per buffer, after a delay for indexing to finish.
local pyright_refreshed_bufs = {}

-- LSP keybindings (only active in buffers with an LSP attached)
-- \d and \n match the old jedi-vim defaults for go-to-definition and find usages
vim.api.nvim_create_autocmd('LspAttach', {
    callback = function(args)
        local opts = { buffer = args.buf }
        vim.keymap.set('n', '<Leader>d', vim.lsp.buf.definition, opts)    -- go to definition (jedi-vim default)
        vim.keymap.set('n', '<Leader>n', vim.lsp.buf.references, opts)    -- find usages (jedi-vim default)
        vim.keymap.set('n', 'gd', vim.lsp.buf.definition, opts)          -- go to definition (vim convention)
        vim.keymap.set('n', 'gr', vim.lsp.buf.references, opts)          -- find references (vim convention)
        vim.keymap.set('n', 'K', vim.lsp.buf.hover, opts)                -- hover docs
        vim.keymap.set('n', '<Leader>rn', vim.lsp.buf.rename, opts)      -- rename symbol
        vim.keymap.set('n', '<Leader>dn', vim.diagnostic.goto_next, opts) -- next diagnostic
        vim.keymap.set('n', '<Leader>dp', vim.diagnostic.goto_prev, opts) -- prev diagnostic

        -- Deferred re-sync for pyright stale diagnostics (once per buffer)
        local client = vim.lsp.get_client_by_id(args.data.client_id)
        if client and client.name == 'pyright' then
            local buf = args.buf
            if not pyright_refreshed_bufs[buf] then
                pyright_refreshed_bufs[buf] = true
                vim.defer_fn(function()
                    if vim.api.nvim_buf_is_valid(buf)
                       and not vim.bo[buf].modified then
                        vim.api.nvim_buf_call(buf, function()
                            local view = vim.fn.winsaveview()
                            vim.cmd('silent! edit')
                            vim.fn.winrestview(view)
                        end)
                    end
                end, 3000)
            end
            vim.api.nvim_create_autocmd('BufDelete', {
                buffer = buf,
                once = true,
                callback = function() pyright_refreshed_bufs[buf] = nil end,
            })
        end
    end,
})

-- Format python files on save using ruff LSP (replaces ALE's ale_fix_on_save for python)
vim.api.nvim_create_autocmd('BufWritePre', {
    pattern = '*.py',
    callback = function()
        vim.lsp.buf.format({ name = 'ruff', async = false })
    end,
})
EOF

" vim: ft=vim
